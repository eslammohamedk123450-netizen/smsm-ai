{
  "name": "suly-ai-router-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bundle:ai-router": "esbuild supabase/functions/ai-router/index.ts --bundle --format=esm --minify --platform=neutral --external:'https://*' --external:'npm:*' --outfile=supabase/deploy-artifacts/ai-router.bundle.js",
